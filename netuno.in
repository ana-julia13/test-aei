! =====================================================================
!  Sistema de Netuno: satelites internos + Tritao
!  (condicoes iniciais do codigo NLSN de Netuno)
! =====================================================================

planeta = Netuno            ! GM, raio (25225 km), J2 e J4 vem de planetas.dat

! ---------------- integracao ----------------
tempo_final = 4000.0        ! dias
passo_saida = 0.058956      ! dias (= periodo de Naiad / 5, como no NLSN)
precisao    = 12

! ---------------- saida ----------------
saida_osculadores = sim
saida_geometricos = sim
pasta_saida       = .
! salvar = Naiad Thalassa  ! so' esses satelites geram .dat (padrao: todos).
!                          ! Os outros continuam na integracao normalmente.

! ---------------- satelites ----------------
! Elementos osculadores planetocentricos em t = 0, no equador de Netuno.
! Massas em kg (no NLSN estavam em gramas: 1.2d20 g = 1.2e17 kg).
unidade_massa = kg

